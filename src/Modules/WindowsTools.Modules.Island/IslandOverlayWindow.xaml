<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="WindowsTools.Modules.Island.IslandOverlayWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
    x:Name="RootGrid"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    PointerPressed="OnPointerPressed">
    <Border
      x:Name="PillContainer"
      CornerRadius="20"
      BorderThickness="1"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
      Padding="14,6">
      <Grid>
        <!-- Collapsed Pill View -->
        <Grid x:Name="CollapsedPanel" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse
            x:Name="StatusDot"
            Grid.Column="0"
            Width="8"
            Height="8"
            VerticalAlignment="Center"
            Fill="{ThemeResource AccentFillColorDefaultBrush}" />

          <TextBlock
            x:Name="CollapsedTitleText"
            Grid.Column="1"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            Style="{StaticResource CaptionTextBlockStyle}" />

          <Border
            x:Name="CollapsedExtraBadge"
            Grid.Column="2"
            Visibility="Collapsed"
            CornerRadius="8"
            Padding="6,1"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            VerticalAlignment="Center">
            <TextBlock
              x:Name="CollapsedExtraText"
              Style="{StaticResource CaptionTextBlockStyle}" />
          </Border>
        </Grid>

        <!-- Expanded Card View -->
        <Grid x:Name="ExpandedPanel" Visibility="Collapsed" RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
              x:Name="ExpandedIcon"
              Grid.Column="0"
              Glyph="&#xE8A7;"
              FontSize="16"
              VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock
                x:Name="ExpandedTitleText"
                TextTrimming="CharacterEllipsis"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock
                x:Name="ExpandedSubtitleText"
                Opacity="0.75"
                TextTrimming="CharacterEllipsis"
                Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <Border
              x:Name="WaitingBadge"
              Grid.Column="2"
              Visibility="Collapsed"
              CornerRadius="6"
              Padding="8,2"
              Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
              VerticalAlignment="Center">
              <TextBlock
                x:Name="WaitingBadgeText"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>

            <Button
              x:Name="CollapseButton"
              Grid.Column="3"
              Click="OnCollapseClicked"
              Style="{StaticResource SubtleButtonStyle}"
              Padding="6">
              <FontIcon Glyph="&#xE70E;" FontSize="12" />
            </Button>
          </Grid>

          <ContentPresenter
            x:Name="CustomContentHost"
            Grid.Row="1"
            Visibility="Collapsed" />

          <ProgressBar
            x:Name="ActivityProgressBar"
            Grid.Row="1"
            Visibility="Collapsed"
            Maximum="1"
            VerticalAlignment="Center" />

          <StackPanel
            x:Name="IndicatorsPanel"
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="6"
            Visibility="Collapsed" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
